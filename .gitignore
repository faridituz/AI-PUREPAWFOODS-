# ============================================================================
# PUREPAW 工作区同步仓库
# 追踪：文档、营销文案、包装资料、验收报告、轻量脚本与素材图片
# 不追踪：代码仓库本体、可重新下载的安装包、沙盒数据、密钥
# ============================================================================

# ---- 独立代码仓库与历史快照 -------------------------------------------
# sales-v1-dev/ 有自己的 GitHub 远端，作为嵌套仓库在这里会被记成 gitlink，
# 会掩盖真实内容并在另一台电脑上误导克隆，因此整目录由它自己的仓库负责。
sales-v1-dev/
# mvp/ 是 7 份文档逐字节相同、代码已包含在 sales-v1-dev 的祖先快照，
# 其 .local/ 内含 data.key 与真实库文件，不做同步。
mvp/
# backups/ 为阶段源码 tar.gz 与 Git bundle，GitHub 上的历史已覆盖其价值。
backups/

# ---- 依赖 --------------------------------------------------------------
node_modules/

# ---- 可重新下载的安装包与原始数据（超过 GitHub 单文件 100MB 硬限）----
work/p15-pg/
work/p15-osm/

# ---- 沙盒演练数据：模拟库、恢复库与月度对账工作目录 -------------------
work/purepaw-month-*/
tmp/

# ---- 本地数据、密钥与环境配置：任何情况下禁止入库 ---------------------
.local/
.env
.env.*
!.env.example
*.sqlite
*.sqlite-*
*.db
*.db-*
*.ppb
*.key
*.pem
*.pfx
*.p12

# ---- 视频/音频大文件与压缩包：走外部存储，不进 Git --------------------
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.wav
*.mp3
*.aac
*.m4a
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.bundle
media/
videos/
footage/
exports/
raw-assets/

# ---- Office 临时锁文件与系统垃圾 ---------------------------------------
~$*
*.tmp
Thumbs.db
desktop.ini
.DS_Store
